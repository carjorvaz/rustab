{
  "manifest_version": 2,
  "name": "rustab",
  "version": "0.1.9",
  "description": "Browser tab management from the terminal",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "scripts": ["background_core.js", "background.js"],
    "persistent": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
